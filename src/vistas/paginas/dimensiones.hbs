{{#> componentes/diapositiva}}
  <div class="dimensiones">
    <header class="cabecera-diapositiva">
      {{> componentes/antetitulo texto=@root.textosDimensiones.antetitulo}}
      <h2 class="cabecera-diapositiva__titulo" id="{{id}}-titulo">{{@root.textosDimensiones.titulo}}</h2>
      <p class="cabecera-diapositiva__entradilla">{{@root.textosDimensiones.resumen}}</p>
    </header>

    <ul class="dimensiones__cuadricula">
      {{#each @root.dimensiones}}
        <li class="dimension dimension--{{cobertura}}" tabindex="0">
          <p class="dimension__numero" aria-hidden="true">{{numero}}</p>
          <h3 class="dimension__titulo">{{titulo}}</h3>
          <p class="dimension__estado">{{etiquetaCobertura}}</p>
          <p class="dimension__variable">{{variable}}</p>
          <dl class="dimension__datos">
            <div><dt>{{@root.textosDimensiones.tierra}}</dt><dd>{{tierra}}</dd></div>
            <div><dt>{{@root.textosDimensiones.espacio}}</dt><dd>{{espacio}}</dd></div>
          </dl>
        </li>
      {{/each}}
    </ul>
  </div>
{{/componentes/diapositiva}}
