{{#> componentes/diapositiva}}
  <div class="lo-que-no">
    <header class="cabecera-diapositiva">
      {{> componentes/antetitulo texto=@root.loQueNo.antetitulo}}
      <h2 class="cabecera-diapositiva__titulo" id="{{id}}-titulo">{{@root.loQueNo.titulo}}</h2>
      <p class="cabecera-diapositiva__entradilla">{{@root.loQueNo.entradilla}}</p>
    </header>

    <ul class="lo-que-no__lista" aria-label="{{@root.loQueNo.etiquetaLista}}">
      {{#each @root.loQueNo.conocidos}}
        <li class="lo-que-no__elemento" style="--i: {{@index}}"><s>{{this}}</s></li>
      {{/each}}
    </ul>

    <p class="lo-que-no__cierre">{{@root.loQueNo.cierre}}</p>
  </div>
{{/componentes/diapositiva}}
