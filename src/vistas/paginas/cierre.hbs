{{#> componentes/diapositiva}}
  <div class="cierre">
    <header class="cabecera-diapositiva">
      {{> componentes/antetitulo texto=@root.cierre.antetitulo}}
      <h2 class="cabecera-diapositiva__titulo" id="{{id}}-titulo">{{@root.cierre.titulo}}</h2>
    </header>
    <p class="cierre__cuerpo">{{@root.cierre.cuerpo}}</p>
    <div class="cierre__accion">
      {{> componentes/boton-demo}}
    </div>
  </div>
{{/componentes/diapositiva}}
