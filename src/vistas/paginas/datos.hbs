{{#> componentes/diapositiva}}
  <div class="datos">
    <header class="cabecera-diapositiva">
      {{> componentes/antetitulo texto=@root.datos.textos.antetitulo}}
      <h2 class="cabecera-diapositiva__titulo" id="{{id}}-titulo">{{@root.datos.textos.titulo}}</h2>
      <p class="cabecera-diapositiva__entradilla">{{@root.datos.textos.entradilla}}</p>
    </header>

    <div class="datos__cuerpos">
      {{#each @root.datos.cuerpos}}
        <section class="datos__cuerpo datos__cuerpo--{{id}}" aria-labelledby="datos-{{id}}">
          <h3 class="datos__titulo-cuerpo" id="datos-{{id}}">{{etiqueta}}</h3>
          <ul class="datos__lista">
            {{#each conjuntos}}
              <li class="conjunto">
                <span class="conjunto__nombre">{{nombre}}</span>
                <span class="conjunto__meta">{{version}} · {{licencia}}</span>
                {{#unless verificada}}<span class="conjunto__aviso">{{@root.datos.textos.sinVerificar}}</span>{{/unless}}
              </li>
            {{/each}}
          </ul>
        </section>
      {{/each}}
    </div>

    <section class="herramientas" aria-labelledby="datos-herramientas">
      <h3 class="herramientas__titulo" id="datos-herramientas">{{@root.datos.textos.tituloHerramientas}}</h3>
      <ul class="herramientas__lista">
        {{#each @root.datos.herramientas}}
          <li class="herramienta">
            <span class="herramienta__detalle">{{detalle}}</span>
            <span class="herramienta__nombre">{{nombre}}</span>
          </li>
        {{/each}}
      </ul>
    </section>

    {{> componentes/etiqueta-dato texto=@root.datos.textos.privado}}
  </div>
{{/componentes/diapositiva}}
