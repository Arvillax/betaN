{{#> components/slide}}
  <div class="challenge">
    <header class="slide-head">
      {{> components/eyebrow text=@root.challenge.eyebrow}}
      <h2 class="slide-head__title" id="{{id}}-title">{{@root.challenge.title}}</h2>
      <p class="slide-head__lead">{{@root.challenge.lead}}</p>
    </header>

    <div class="challenge__cards">
      {{#each @root.challenge.questions}}
        {{> components/card}}
      {{/each}}
    </div>
  </div>
{{/components/slide}}
