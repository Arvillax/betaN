{{#> components/slide}}
  <div class="comparator" data-comparator>
    <header class="slide-head">
      {{> components/eyebrow text=@root.comparator.copy.eyebrow}}
      <h2 class="slide-head__title" id="{{id}}-title">{{@root.comparator.copy.title}}</h2>
      <p class="slide-head__lead">{{@root.comparator.copy.lead}}</p>
      {{> components/data-tag text=@root.comparator.copy.sampleTag}}
    </header>

    <form class="comparator__controls" data-comparator-form>
      <fieldset class="segmented">
        <legend class="comparator__legend">Destino</legend>
        {{#each @root.comparator.destinations}}
          <label class="segmented__option">
            <input type="radio" name="destination" value="{{id}}" {{#if @first}}checked{{/if}} />
            <span>{{label}}</span>
          </label>
        {{/each}}
      </fieldset>

      <fieldset class="comparator__profiles">
        <legend class="comparator__legend">Uso</legend>
        {{#each @root.comparator.profiles}}
          <button class="chip" type="button" data-profile="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>
        {{/each}}
      </fieldset>

      <fieldset class="comparator__weights">
        <legend class="comparator__legend">Peso de cada variable</legend>
        {{#each @root.comparator.variables}}
          {{> components/slider}}
        {{/each}}
      </fieldset>
    </form>

    <section class="comparator__result" aria-label="Resultado" aria-live="polite">
      <p class="comparator__site" data-site></p>
      <p class="comparator__score">
        <span class="comparator__score-value" data-score>—</span>
        <span class="comparator__score-label">{{@root.comparator.copy.scoreLabel}}</span>
      </p>
      <p class="comparator__used" data-used></p>

      <ul class="bars">
        {{#each @root.comparator.variables}}
          <li class="bars__row" data-bar="{{id}}">
            <span class="bars__label">{{label}}</span>
            <span class="bars__track"><span class="bars__fill"></span></span>
            <span class="bars__value" data-bar-value></span>
          </li>
        {{/each}}
      </ul>

      <div class="comparator__verdicts">
        <div>
          <h3 class="comparator__list-title">Coincide</h3>
          <ul class="comparator__list" data-list="coincide"></ul>
        </div>
        <div>
          <h3 class="comparator__list-title">Difiere</h3>
          <ul class="comparator__list" data-list="difiere"></ul>
        </div>
        <div>
          <h3 class="comparator__list-title">La Tierra no reproduce</h3>
          <ul class="comparator__list" data-list="earth-cannot"></ul>
        </div>
      </div>

      <p class="comparator__note">{{@root.comparator.copy.note}}</p>
    </section>
  </div>
{{/components/slide}}
