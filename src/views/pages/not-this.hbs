{{#> components/slide}}
  <div class="not-this">
    <header class="slide-head">
      {{> components/eyebrow text=@root.notThis.eyebrow}}
      <h2 class="slide-head__title" id="{{id}}-title">{{@root.notThis.title}}</h2>
      <p class="slide-head__lead">{{@root.notThis.lead}}</p>
    </header>

    <ul class="not-this__list" aria-label="Análogos ya estudiados, fuera del alcance">
      {{#each @root.notThis.known}}
        <li class="not-this__item" style="--i: {{@index}}"><s>{{this}}</s></li>
      {{/each}}
    </ul>

    <p class="not-this__closing">{{@root.notThis.closing}}</p>
  </div>
{{/components/slide}}
