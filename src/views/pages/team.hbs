{{#> components/slide}}
  <div class="team">
    {{> components/logo size="l"}}
    {{> components/eyebrow text=@root.team.copy.eyebrow}}
    <h2 class="visually-hidden" id="{{id}}-title">{{@root.team.copy.title}}</h2>
    <p class="team__lead">{{@root.team.copy.lead}}</p>

    {{#if @root.team.members.length}}
      <ul class="team__members">
        {{#each @root.team.members}}
          <li class="member">
            <p class="member__name">{{#if url}}<a href="{{url}}">{{name}}</a>{{else}}{{name}}{{/if}}</p>
            <p class="member__role">{{role}}</p>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="team__empty">{{@root.team.copy.empty}}</p>
    {{/if}}

    <p class="team__closing">{{@root.team.copy.closing}}</p>

    <footer class="team__footer">
      <span>© {{@root.year}} {{@root.site.team}} · {{@root.site.city}}</span>
      <span>{{@root.site.event}}</span>
    </footer>
  </div>
{{/components/slide}}
