{{#> components/slide}}
  <div class="dimensions">
    <header class="slide-head">
      {{> components/eyebrow text=@root.dimensionsCopy.eyebrow}}
      <h2 class="slide-head__title" id="{{id}}-title">{{@root.dimensionsCopy.title}}</h2>
      <p class="slide-head__lead">{{@root.dimensionsCopy.summary}}</p>
    </header>

    <ul class="dimensions__grid">
      {{#each @root.dimensions}}
        <li class="dimension dimension--{{coverage}}" tabindex="0">
          <p class="dimension__number" aria-hidden="true">{{number}}</p>
          <h3 class="dimension__title">{{title}}</h3>
          <p class="dimension__status">{{coverageLabel}}</p>
          <p class="dimension__variable">{{variable}}</p>
          <dl class="dimension__data">
            <div><dt>Tierra</dt><dd>{{earth}}</dd></div>
            <div><dt>Luna · Marte</dt><dd>{{space}}</dd></div>
          </dl>
        </li>
      {{/each}}
    </ul>
  </div>
{{/components/slide}}
