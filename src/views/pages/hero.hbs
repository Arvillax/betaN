{{#> components/slide}}
  <div class="hero">
    <div class="hero__signature">
      {{> components/logo size="l"}}
      {{> components/eyebrow text=@root.hero.eyebrow}}
    </div>

    <h1 class="hero__title" id="{{id}}-title">
      {{#each @root.hero.titleLines}}
        <span class="hero__line" style="--i: {{@index}}">{{this}}</span>
      {{/each}}
      <span class="hero__accent">{{@root.hero.accent}}</span>
    </h1>

    <p class="hero__lead">{{@root.hero.lead}}</p>

    <div class="hero__actions">
      {{> components/button href="#reto" label=@root.hero.cta variant="primary" icon="↓"}}
      <p class="hero__hint">{{@root.hero.hint}}</p>
    </div>
  </div>
{{/components/slide}}
