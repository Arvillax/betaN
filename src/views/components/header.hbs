<header class="site-header">
  <a class="site-header__brand" href="#{{@root.slides.[0].id}}" aria-label="{{@root.site.team}} — volver al inicio">
    {{> components/logo size="s"}}
  </a>

  <p class="site-header__worlds" aria-label="Mundo que muestra el fondo">
    {{#each @root.worlds}}
      <span class="site-header__world" data-world-label="{{id}}">{{label}}</span>
    {{/each}}
  </p>

  <p class="site-header__count" aria-live="polite">
    <span data-slide-current>01</span><span aria-hidden="true"> / </span><span class="visually-hidden"> de </span>{{padTotal @root.slides}}
  </p>
</header>
