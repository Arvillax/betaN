{{!-- Block partial that wraps every page. Context: one entry of content/slides.js. --}}
<section
  class="slide slide--{{tone}} slide--{{id}}"
  id="{{id}}"
  data-slide
  data-world="{{world}}"
  data-tone="{{tone}}"
  aria-labelledby="{{id}}-title"
>
  <div class="slide__inner">
    {{> @partial-block}}
  </div>
</section>
